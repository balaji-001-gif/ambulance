{
  "name": "Ambulance Bill",
  "module": "BAS Ambulance Service",
  "doctype": "DocType",
  "is_submittable": 1,
  "autoname": "format:ABILL-{YYYY}-{#####}",
  "fields": [
    {"fieldname":"trip_sheet","label":"Trip Sheet",
     "fieldtype":"Link","options":"Ambulance Trip Sheet","reqd":1},
    {"fieldname":"patient_name","label":"Patient Name","fieldtype":"Data",
     "fetch_from":"trip_sheet.patient_name","read_only":1},
    {"fieldname":"bill_date","label":"Bill Date","fieldtype":"Date",
     "reqd":1,"default":"Today"},
    {"fieldname":"billing_mode","label":"Billing Mode","fieldtype":"Select",
     "options":"Cash\nInsurance\nCGHS\nESI\nGovernment Scheme\nCorporate\nFree\nWaived",
     "reqd":1,"in_list_view":1},
    {"fieldname":"col_break_1","fieldtype":"Column Break"},
    {"fieldname":"payment_status","label":"Payment Status","fieldtype":"Select",
     "options":"Unpaid\nPartial\nPaid\nWaived","default":"Unpaid",
     "in_list_view":1},
    {"fieldname":"corporate_client","label":"Corporate Client",
     "fieldtype":"Link","options":"Customer",
     "depends_on":"eval:doc.billing_mode=='Corporate'"},
    {"fieldname":"insurance_company","label":"Insurance Company",
     "fieldtype":"Link","options":"Customer",
     "depends_on":"eval:['Insurance','CGHS','ESI'].includes(doc.billing_mode)"},
    {"fieldname":"policy_number","label":"Policy / Card No.","fieldtype":"Data"},
    {"fieldname":"pre_auth_no","label":"Pre-Authorisation No.","fieldtype":"Data"},
    {"fieldname":"sec_charges","label":"Charges","fieldtype":"Section Break"},
    {"fieldname":"service_charges","label":"Service Charges",
     "fieldtype":"Table","options":"Sales Invoice Item"},
    {"fieldname":"sec_amounts","label":"Amounts","fieldtype":"Section Break"},
    {"fieldname":"gross_amount","label":"Gross Amount","fieldtype":"Currency",
     "read_only":1},
    {"fieldname":"discount_pct","label":"Discount %","fieldtype":"Float"},
    {"fieldname":"discount_amount","label":"Discount Amount","fieldtype":"Currency"},
    {"fieldname":"net_amount","label":"Net Amount","fieldtype":"Currency",
     "read_only":1},
    {"fieldname":"advance_received","label":"Advance Received","fieldtype":"Currency"},
    {"fieldname":"balance_due","label":"Balance Due","fieldtype":"Currency",
     "read_only":1},
    {"fieldname":"erpnext_sales_invoice","label":"Sales Invoice",
     "fieldtype":"Link","options":"Sales Invoice"}
  ],
  "permissions": [
    {"role":"Billing Executive","read":1,"write":1,"create":1,"submit":1},
    {"role":"Accounts Manager","read":1,"write":1,"submit":0,"cancel":1},
    {"role":"System Manager","read":1,"write":1,"create":1,"delete":1,"submit":1}
  ]
}
