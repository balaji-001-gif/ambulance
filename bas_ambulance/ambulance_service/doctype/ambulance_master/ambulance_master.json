{
  "name": "Ambulance Master",
  "module": "BAS Ambulance Service",
  "doctype": "DocType",
  "is_submittable": 0,
  "track_changes": 1,
  "autoname": "format:AMB-{YYYY}-{###}",
  "title_field": "vehicle_id",
  "search_fields": "registration_number,vehicle_type,home_station",
  "sort_field": "creation",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "vehicle_id", "label": "Vehicle ID", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "bold": 1},
    {"fieldname": "registration_number", "label": "Registration Number", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "vehicle_type", "label": "Vehicle Type", "fieldtype": "Select",
     "options": "BLS\nALS\nNeonatal\nFeeder (Bike)\nReferral\nMMU\nBoat\nVeterinary", "reqd": 1, "in_list_view": 1},
    {"fieldname": "assigned_helpline", "label": "Assigned Helpline", "fieldtype": "Select",
     "options": "108\n102\n104\n112\n1033\n100\n181\nCorporate\nMMU"},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "operational_status", "label": "Operational Status", "fieldtype": "Select",
     "options": "Available\nOn Trip\nUnder Maintenance\nOut of Service", "default": "Available", "in_list_view": 1},
    {"fieldname": "home_station", "label": "Home Station", "fieldtype": "Link", "options": "Ambulance Station", "reqd": 1},
    {"fieldname": "gps_device", "label": "GPS Device", "fieldtype": "Link", "options": "GPS Device Master"},
    {"fieldname": "current_gps_status", "label": "GPS Status", "fieldtype": "Select",
     "options": "Online\nOffline\nUnknown", "default": "Unknown"},
    {"fieldname": "sec_specs", "label": "Vehicle Specifications", "fieldtype": "Section Break"},
    {"fieldname": "make_model", "label": "Make & Model", "fieldtype": "Data"},
    {"fieldname": "year_of_manufacture", "label": "Year of Manufacture", "fieldtype": "Int"},
    {"fieldname": "chassis_number", "label": "Chassis Number", "fieldtype": "Data"},
    {"fieldname": "engine_number", "label": "Engine Number", "fieldtype": "Data"},
    {"fieldname": "fuel_type", "label": "Fuel Type", "fieldtype": "Select", "options": "Diesel\nCNG\nElectric\nPetrol"},
    {"fieldname": "sec_docs", "label": "Documents & Compliance", "fieldtype": "Section Break"},
    {"fieldname": "fitness_cert_no", "label": "Fitness Certificate No.", "fieldtype": "Data"},
    {"fieldname": "fitness_expiry", "label": "Fitness Expiry Date", "fieldtype": "Date"},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "insurance_policy_no", "label": "Insurance Policy No.", "fieldtype": "Data"},
    {"fieldname": "insurance_expiry", "label": "Insurance Expiry", "fieldtype": "Date"},
    {"fieldname": "col_break_3", "fieldtype": "Column Break"},
    {"fieldname": "permit_number", "label": "Permit Number", "fieldtype": "Data"},
    {"fieldname": "permit_expiry", "label": "Permit Expiry", "fieldtype": "Date"},
    {"fieldname": "puc_certificate_no", "label": "Pollution Certificate No.", "fieldtype": "Data"},
    {"fieldname": "puc_expiry", "label": "PUC Expiry", "fieldtype": "Date"},
    {"fieldname": "sec_equip", "label": "Equipment", "fieldtype": "Section Break"},
    {"fieldname": "ventilator_available", "label": "Ventilator Available", "fieldtype": "Check"},
    {"fieldname": "defibrillator_available", "label": "Defibrillator Available", "fieldtype": "Check"},
    {"fieldname": "cardiac_monitor", "label": "Cardiac Monitor", "fieldtype": "Check"},
    {"fieldname": "oxygen_capacity", "label": "Oxygen Capacity (L)", "fieldtype": "Float"},
    {"fieldname": "iv_medication_kit", "label": "IV Medication Kit", "fieldtype": "Check"},
    {"fieldname": "neonatal_equipment", "label": "Neonatal Equipment", "fieldtype": "Check"},
    {"fieldname": "sec_service", "label": "Service", "fieldtype": "Section Break"},
    {"fieldname": "last_service_date", "label": "Last Service Date", "fieldtype": "Date"},
    {"fieldname": "next_service_due", "label": "Next Service Due Date", "fieldtype": "Date"},
    {"fieldname": "next_service_km", "label": "Next Service Due (km)", "fieldtype": "Float"},
    {"fieldname": "remarks", "label": "Remarks", "fieldtype": "Small Text"}
  ],
  "permissions": [
    {"role": "Fleet Manager", "read": 1, "write": 1, "create": 1, "delete": 0, "submit": 0},
    {"role": "Dispatch Officer", "read": 1, "write": 0, "create": 0},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
