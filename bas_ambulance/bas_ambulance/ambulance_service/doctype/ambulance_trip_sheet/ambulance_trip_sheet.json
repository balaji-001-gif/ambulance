{
  "name": "Ambulance Trip Sheet",
  "module": "BAS Ambulance Service",
  "doctype": "DocType",
  "is_submittable": 1,
  "autoname": "format:TRIP-{YYYY}-{#####}",
  "track_changes": 1,
  "fields": [
    {"fieldname":"helpline_call","label":"Helpline Call",
     "fieldtype":"Link","options":"Helpline Call Record","reqd":1},
    {"fieldname":"ambulance","label":"Ambulance",
     "fieldtype":"Link","options":"Ambulance Master","reqd":1},
    {"fieldname":"trip_type","label":"Trip Type","fieldtype":"Select",
     "options":"Emergency\nMaternity (102)\nReferral\nMMU\nNeonatal\nHighway\nVeterinary"},
    {"fieldname":"trip_status","label":"Trip Status","fieldtype":"Select",
     "options":"Draft\nIn Progress\nPending Review\nApproved\nBilled\nCancelled\nIncident Reported",
     "default":"Draft","in_list_view":1},
    {"fieldname":"sec_timestamps","label":"Timestamps","fieldtype":"Section Break"},
    {"fieldname":"departure_time","label":"Departure Time","fieldtype":"Datetime"},
    {"fieldname":"scene_arrival_time","label":"Scene Arrival","fieldtype":"Datetime"},
    {"fieldname":"patient_pickup_time","label":"Patient Pickup","fieldtype":"Datetime"},
    {"fieldname":"hospital_arrival_time","label":"Hospital Arrival","fieldtype":"Datetime"},
    {"fieldname":"return_to_base_time","label":"Return to Base","fieldtype":"Datetime"},
    {"fieldname":"response_time_min","label":"Response Time (min)",
     "fieldtype":"Float","read_only":1},
    {"fieldname":"total_duration_min","label":"Total Duration (min)",
     "fieldtype":"Float","read_only":1},
    {"fieldname":"sec_odometer","label":"Odometer","fieldtype":"Section Break"},
    {"fieldname":"odometer_start","label":"Odometer Start (km)","fieldtype":"Float"},
    {"fieldname":"odometer_end","label":"Odometer End (km)","fieldtype":"Float"},
    {"fieldname":"distance_covered","label":"Distance (km)",
     "fieldtype":"Float","read_only":1},
    {"fieldname":"sec_vitals","label":"Patient Vitals","fieldtype":"Section Break"},
    {"fieldname":"patient_condition","label":"Condition on Pickup",
     "fieldtype":"Select",
     "options":"Stable\nCritical\nUnconscious\nDead on Arrival"},
    {"fieldname":"gcs_score","label":"GCS Score","fieldtype":"Int"},
    {"fieldname":"blood_pressure","label":"BP (mmHg)","fieldtype":"Data"},
    {"fieldname":"pulse_rate","label":"Pulse (bpm)","fieldtype":"Int"},
    {"fieldname":"spo2","label":"SpO2 (%)","fieldtype":"Float"},
    {"fieldname":"blood_sugar","label":"Blood Sugar (mg/dL)","fieldtype":"Float"},
    {"fieldname":"temperature","label":"Temperature (C)","fieldtype":"Float"},
    {"fieldname":"respiratory_rate","label":"Respiratory Rate","fieldtype":"Int"},
    {"fieldname":"sec_procedures","label":"Procedures","fieldtype":"Section Break"},
    {"fieldname":"cpr_performed","label":"CPR Performed","fieldtype":"Check"},
    {"fieldname":"defibrillation_given","label":"Defibrillation Given",
     "fieldtype":"Check"},
    {"fieldname":"no_of_shocks","label":"No. of Shocks","fieldtype":"Int",
     "depends_on":"eval:doc.defibrillation_given"},
    {"fieldname":"iv_access","label":"IV Access Established","fieldtype":"Check"},
    {"fieldname":"oxygen_used","label":"Oxygen Used (L)","fieldtype":"Float"},
    {"fieldname":"in_ambulance_delivery","label":"In-Ambulance Delivery",
     "fieldtype":"Check"},
    {"fieldname":"baby_condition","label":"Baby Condition",
     "fieldtype":"Select","options":"Alive\nStillborn\nN/A",
     "depends_on":"eval:doc.in_ambulance_delivery"},
    {"fieldname":"sec_handover","label":"Handover","fieldtype":"Section Break"},
    {"fieldname":"receiving_hospital","label":"Receiving Hospital",
     "fieldtype":"Link","options":"Customer"},
    {"fieldname":"receiving_doctor","label":"Receiving Doctor/Nurse",
     "fieldtype":"Data"},
    {"fieldname":"handover_time","label":"Handover Time","fieldtype":"Datetime"},
    {"fieldname":"handover_remarks","label":"Handover Remarks",
     "fieldtype":"Small Text"},
    {"fieldname":"incident_flagged","label":"Incident Flagged","fieldtype":"Check"},
    {"fieldname":"billing_status","label":"Billing Status","fieldtype":"Select",
     "options":"Pending\nBilled\nCollected\nWaived\nGovernment Sponsored",
     "default":"Pending"}
  ],
  "permissions": [
    {"role":"Paramedic","read":1,"write":1,"create":1,"submit":1},
    {"role":"Fleet Manager","read":1,"write":1,"create":0,"submit":0,"amend":1},
    {"role":"Billing Executive","read":1,"write":0},
    {"role":"System Manager","read":1,"write":1,"create":1,"delete":1,"submit":1,"amend":1}
  ],
  "autoname": "format:TRIP-{YYYY}-{#####}"
}
